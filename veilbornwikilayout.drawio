        <mxCell id="cteeXFExkGseJQqinhMh-1" parent="1" style="text;html=1;overflow=hidden;rounded=0;perimeterSpacing=1;strokeColor=default;whiteSpace=wrap;spacingTop=2;spacingRight=2;spacingBottom=2;spacingLeft=2;verticalAlign=middle;align=center;fontFamily=Cinzel;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DCinzel;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;War Above&lt;/h1&gt;&lt;div&gt;Ancient war between &lt;b&gt;Selynthar&lt;/b&gt; and &lt;b&gt;The Hand That Takes.&lt;/b&gt; Predates everything, ending in Selynthar&#39;s victory after sin was sealed into the &lt;b&gt;Godscar&lt;/b&gt;&lt;/div&gt;" vertex="1">
