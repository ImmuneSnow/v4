        <mxCell id="CnyTc_cmp-E1sZ_Ip6yX-4" parent="1" style="text;html=1;overflow=hidden;rounded=0;perimeterSpacing=1;strokeColor=default;whiteSpace=wrap;spacingTop=2;spacingRight=2;spacingBottom=2;spacingLeft=2;verticalAlign=middle;align=center;fontFamily=Cinzel;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DCinzel;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;The Hand That Takes&lt;/h1&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Cinzel&quot;&gt;Being of Sin, fought against &lt;b&gt;Selynthar&lt;/b&gt; in the War above. trapped inside the &lt;b&gt;Godscar&lt;/b&gt;. Eventually &lt;b&gt;Ruptured&lt;/b&gt;, taking one of the &lt;b&gt;Four Great Knights&lt;/b&gt; and turning him into the &lt;b&gt;Veiled One&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="208.5" width="180" x="649" y="118" as="geometry" />
        </mxCell>
